# ==============================================================================
# SOLAR LMS 2.0 - VARIÁVEIS DE AMBIENTE (.NET 10 + DOCKER)
# ==============================================================================

# Configurações do ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
PORT=5142

# Banco de Dados PostgreSQL
POSTGRES_DB=solar_development
POSTGRES_USER=solar
POSTGRES_PASSWORD=solar_secret
POSTGRES_PORT=5433
ConnectionStrings__DefaultConnection=Host=solar-db;Port=5432;Database=solar_development;Username=solar;Password=solar_secret;

# Cache e Sessão Redis
REDIS_PORT=6380
ConnectionStrings__Redis=solar-redis:6379

# Autenticação JWT
Jwt__Secret=solar_super_secret_jwt_key_with_at_least_256_bits_for_production_use!
Jwt__Issuer=SolarLMS
Jwt__Audience=SolarUsers
Jwt__ExpirationHours=24

# Integração com Webconferência (BigBlueButton)
BigBlueButton__ServerUrl=https://bbb.virtual.ufc.br/bigbluebutton
BigBlueButton__SharedSecret=solar_bbb_secret
