# ==============================================================================
# SOLAR LMS 2.0 - VARIÁVEIS DE AMBIENTE (.NET 10 + DOCKER)
# ==============================================================================

# Configurações do ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
PORT=5142

# Banco de Dados PostgreSQL (Configuração Local / Docker)
POSTGRES_DB=solar_development
POSTGRES_USER=solar
POSTGRES_PASSWORD=sua_senha_local_segura_aqui
POSTGRES_PORT=5433
ConnectionStrings__DefaultConnection=Host=solar-db;Port=5432;Database=solar_development;Username=solar;Password=sua_senha_local_segura_aqui;

# Cache e Sessão Redis
REDIS_PORT=6380
ConnectionStrings__Redis=solar-redis:6379

# Autenticação JWT (Chave de Desenvolvimento - Altere obrigatoriamente em Produção)
Jwt__Secret=chave_secreta_jwt_de_desenvolvimento_com_no_minimo_256_bits_troque_em_producao!
Jwt__Issuer=SolarLMS
Jwt__Audience=SolarUsers
Jwt__ExpirationHours=24

# Integração com Webconferência (BigBlueButton)
BigBlueButton__ServerUrl=https://bbb.virtual.ufc.br/bigbluebutton
BigBlueButton__SharedSecret=seu_bbb_secret_aqui

# Observabilidade e Rastreamento de Erros (Sentry - Opcional)
SENTRY_DSN=https://seu_sentry_dsn_aqui@o0.ingest.sentry.io/0

# Servidor de Logs Visuais (Seq - Opcional / Dashboard Web)
SEQ_PORT=5341
SEQ_SERVER_URL=http://localhost:5341
